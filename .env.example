# FunLearn — Environment Variables Reference
# Copy this file to .env.local and fill in your values

# ==============================================================================
# 1. SUPABASE (Required for Live Auth & Row Level Security)
# Get these from: Supabase Dashboard → Project Settings → API
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ==============================================================================
# 2. REAL SMS GATEWAY PROVIDERS (Choose any one to send live SMS to Indian phones)
# ==============================================================================

# Option A: Fast2SMS (Popular low-cost SMS API in India with quick setup)
# Get API Key from: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your-fast2sms-api-key

# Option B: Twilio SMS (Global SMS delivery)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Option C: 2Factor.in (Indian SMS & OTP service)
# Get API Key from: https://2factor.in/
# TWO_FACTOR_API_KEY=your-2factor-api-key
